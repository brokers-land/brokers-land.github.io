<%- include('../partials/admin-header') %>
<div class="two-col">
  <form class="panel form" method="post" action="/admin/account/password">
    <h2>เปลี่ยนรหัสผ่าน</h2>
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <label>รหัสผ่านปัจจุบัน<input type="password" name="current_password" required autocomplete="current-password"></label>
    <label>รหัสผ่านใหม่ (อย่างน้อย 8 ตัว)<input type="password" name="new_password" required minlength="8" autocomplete="new-password"></label>
    <label>ยืนยันรหัสผ่านใหม่<input type="password" name="confirm_password" required minlength="8" autocomplete="new-password"></label>
    <button class="btn" type="submit">เปลี่ยนรหัสผ่าน</button>
  </form>
  <div class="panel">
    <h2>ผู้ดูแลระบบ</h2>
    <ul class="list">
      <% users.forEach(u => { %>
        <li class="row-between">
          <span><strong><%= u.username %></strong> <small class="muted">สร้างเมื่อ <%= u.created_at %></small> <%= u.id === currentUser.id ? '(คุณ)' : '' %></span>
          <% if (u.id !== currentUser.id) { %>
          <form method="post" action="/admin/account/users/<%= u.id %>/delete" onsubmit="return confirm('ลบผู้ดูแล <%= u.username %>?')">
            <input type="hidden" name="_csrf" value="<%= csrf() %>"><button class="btn btn-sm btn-danger">ลบ</button>
          </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
    <form class="form" method="post" action="/admin/account/users">
      <h3>เพิ่มผู้ดูแลใหม่</h3>
      <input type="hidden" name="_csrf" value="<%= csrf() %>">
      <label>ชื่อผู้ใช้ (ภาษาอังกฤษ)<input name="username" required pattern="[a-zA-Z0-9_.\-]{3,30}"></label>
      <label>รหัสผ่าน (อย่างน้อย 8 ตัว)<input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
      <button class="btn" type="submit">เพิ่มผู้ดูแล</button>
    </form>
  </div>
</div>
<%- include('../partials/admin-footer') %>
