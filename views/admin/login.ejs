<%- include('../partials/head') %>
<body class="login-page">
  <form class="panel login-box form" method="post" action="/admin/login">
    <h1><%= settings.site_name %></h1>
    <p class="muted">เข้าสู่ระบบผู้ดูแล</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrf() %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>ชื่อผู้ใช้<input name="username" required autofocus autocomplete="username"></label>
    <label>รหัสผ่าน<input name="password" type="password" required autocomplete="current-password"></label>
    <button class="btn btn-block" type="submit">เข้าสู่ระบบ</button>
    <p class="center"><a href="/">← กลับหน้าเว็บไซต์</a></p>
  </form>
</body>
</html>
