<%- include('head') %>
<body>
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M5 20V10l7-5 7 5v10"/><path d="M9 20v-5h6v5"/></svg>
      </span>
      <span>
        <strong><%= settings.site_name %></strong>
        <small><%= settings.tagline %></small>
      </span>
    </a>
    <button class="nav-toggle" aria-label="เมนู" onclick="document.body.classList.toggle('nav-open')">☰</button>
    <nav class="nav-links">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">หน้าแรก</a>
      <a href="/lands" class="<%= currentPath.startsWith('/lands') ? 'active' : '' %>">ประกาศขายที่ดิน</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">ติดต่อเรา / ฝากขาย</a>
      <% if (settings.phone) { %><a class="btn btn-sm" href="tel:<%= settings.phone.replace(/[^0-9+]/g, '') %>">📞 <%= settings.phone %></a><% } %>
    </nav>
  </div>
</header>
<main>
<% if (flash) { %><div class="container"><div class="alert alert-<%= flash.type %>"><%= flash.message %></div></div><% } %>
