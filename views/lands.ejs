<%- include('partials/header') %>
<section class="container section">
  <h1 class="page-title">ประกาศขายที่ดิน</h1>
  <form class="filters" method="get" action="/lands">
    <input type="text" name="q" value="<%= q.q || '' %>" placeholder="คำค้นหา">
    <select name="province">
      <option value="">ทุกจังหวัด</option>
      <% PROVINCES.forEach(p => { %><option <%= q.province === p ? 'selected' : '' %>><%= p %></option><% }) %>
    </select>
    <select name="type">
      <option value="">ทุกประเภท</option>
      <% LAND_TYPES.forEach(t => { %><option <%= q.type === t ? 'selected' : '' %>><%= t %></option><% }) %>
    </select>
    <select name="status">
      <option value="">ทุกสถานะ</option>
      <% Object.entries(h.STATUS).forEach(([k, v]) => { %><option value="<%= k %>" <%= q.status === k ? 'selected' : '' %>><%= v.label %></option><% }) %>
    </select>
    <input type="number" name="min_price" min="0" step="any" value="<%= q.min_price || '' %>" placeholder="ราคาต่ำสุด (บาท)">
    <input type="number" name="max_price" min="0" step="any" value="<%= q.max_price || '' %>" placeholder="ราคาสูงสุด (บาท)">
    <input type="number" name="min_rai" min="0" step="any" value="<%= q.min_rai || '' %>" placeholder="ขนาดต่ำสุด (ไร่)">
    <input type="number" name="max_rai" min="0" step="any" value="<%= q.max_rai || '' %>" placeholder="ขนาดสูงสุด (ไร่)">
    <select name="sort">
      <option value="newest">ล่าสุด</option>
      <option value="price_asc" <%= q.sort === 'price_asc' ? 'selected' : '' %>>ราคา ต่ำ → สูง</option>
      <option value="price_desc" <%= q.sort === 'price_desc' ? 'selected' : '' %>>ราคา สูง → ต่ำ</option>
      <option value="area_desc" <%= q.sort === 'area_desc' ? 'selected' : '' %>>ขนาด ใหญ่ → เล็ก</option>
      <option value="area_asc" <%= q.sort === 'area_asc' ? 'selected' : '' %>>ขนาด เล็ก → ใหญ่</option>
    </select>
    <div class="filter-actions">
      <button class="btn" type="submit">ค้นหา</button>
      <a class="btn btn-ghost" href="/lands">ล้าง</a>
    </div>
  </form>

  <p class="muted">พบ <%= total %> ประกาศ</p>
  <% if (lands.length) { %>
    <div class="grid">
      <% lands.forEach(land => { %><%- include('partials/land-card', { land }) %><% }) %>
    </div>
  <% } else { %>
    <p class="empty">ไม่พบที่ดินตามเงื่อนไขที่ค้นหา</p>
  <% } %>

  <% if (pages > 1) {
       const qs = n => { const p = new URLSearchParams(Object.entries(q).filter(([k, v]) => k !== 'page' && typeof v === 'string' && v)); p.set('page', n); return '?' + p.toString(); }; %>
    <nav class="pager">
      <% for (let i = 1; i <= pages; i++) { %>
        <a href="<%= qs(i) %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </nav>
  <% } %>
</section>
<%- include('partials/footer') %>
